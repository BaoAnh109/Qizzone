# Supabase Edge Functions server-only secrets (NEVER expose to frontend or commit real values)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_DAILY_USER_LIMIT=100

# Cloudflare R2 Private Bucket S3 Credentials
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET_NAME=qizzone-materials-staging
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

# Brevo Email API v3 & Cron Secret
BREVO_API_KEY=YOUR_BREVO_API_V3_KEY
BREVO_FROM_EMAIL=no-reply@your-verified-domain.example
BREVO_FROM_NAME=Qizzone
BREVO_DAILY_LIMIT=300
CRON_SECRET=YOUR_INTERNAL_CRON_SECRET

# Allowed CORS Origins (exact scheme + host, comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_STAGING_DOMAIN
