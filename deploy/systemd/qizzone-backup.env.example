# Copy to /etc/qizzone/backup.env and fill with the confirmed offsite settings.
# Keep the rclone config itself outside Git with mode 600; it contains credentials.
AGE_RECIPIENT=age1replace-with-backup-recipient-public-key
QIZZONE_BACKUP_REMOTE=other-provider:encrypted-backups/qizzone
QIZZONE_RCLONE_CONFIG_FILE=/etc/qizzone/rclone.conf
