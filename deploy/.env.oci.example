# Production candidate only. Copy to /etc/qizzone/production.env on a verified OCI host.
# This template contains public settings and secret-file paths; never put secret values here.
POSTGRES_IMAGE=postgres:17.12-alpine3.24
POSTGRES_DB=qizzone
POSTGRES_ADMIN_USER=qizzone_admin
POSTGRES_ADMIN_PASSWORD_FILE=/etc/qizzone/secrets/postgres-admin-password.txt
QIZZONE_APP_DB_PASSWORD_FILE=/etc/qizzone/secrets/qizzone-app-db-password.txt
QIZZONE_MIGRATOR_DB_PASSWORD_FILE=/etc/qizzone/secrets/qizzone-migrator-db-password.txt
QIZZONE_APP_CONNECTION_STRING_FILE=/etc/qizzone/secrets/qizzone-app-connection-string.txt
QIZZONE_MIGRATION_CONNECTION_STRING_FILE=/etc/qizzone/secrets/qizzone-migrator-connection-string.txt
FIREBASE_SERVICE_ACCOUNT_FILE=/etc/qizzone/secrets/firebase-service-account.json
GEMINI_API_KEY_FILE=/etc/qizzone/secrets/gemini-api-key.txt

# Fill only after account, DNS, Firebase project and release revision are verified.
API_HOST=api.example.com
ACME_EMAIL=ops@example.com
FRONTEND_ORIGIN=https://qizzone.vercel.app
FIREBASE_PROJECT_ID=
BOOTSTRAP_ADMIN_UID=
QIZZONE_RELEASE_SHA=

# These are resource ceilings for one 2-OCPU/12-GiB A1 VM, not measured capacity.
API_CPU_LIMIT=1
API_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=0.5
POSTGRES_MEMORY_LIMIT=4g
WORKER_CPU_LIMIT=0.25
WORKER_MEMORY_LIMIT=1g
CADDY_CPU_LIMIT=0.25
CADDY_MEMORY_LIMIT=256m
GEMINI_MODEL=gemini-3.8-flash
