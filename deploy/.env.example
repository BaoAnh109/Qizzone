# Local development only. Copy to deploy/.env and replace the password before starting.
POSTGRES_DB=qizzone
POSTGRES_USER=qizzone
POSTGRES_PASSWORD=replace-with-a-local-random-password
POSTGRES_PORT=5432
API_PORT=8080
FRONTEND_PORT=5173

# Firebase web configuration is public client config, but use a test Firebase project.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
BOOTSTRAP_ADMIN_UID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Transitional frontend paths still require the existing Supabase client configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required only when the optional AI worker profile is started.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
