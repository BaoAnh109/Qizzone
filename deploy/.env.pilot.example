# Copy to deploy/.env.pilot. This file contains paths and public configuration only.
POSTGRES_IMAGE=postgres:17.12-alpine3.24
POSTGRES_DB=qizzone
POSTGRES_ADMIN_USER=qizzone_admin
POSTGRES_ADMIN_PASSWORD_FILE=./secrets/postgres-admin-password.txt
QIZZONE_APP_DB_PASSWORD_FILE=./secrets/qizzone-app-db-password.txt
QIZZONE_MIGRATOR_DB_PASSWORD_FILE=./secrets/qizzone-migrator-db-password.txt
QIZZONE_APP_CONNECTION_STRING_FILE=./secrets/qizzone-app-connection-string.txt
QIZZONE_MIGRATION_CONNECTION_STRING_FILE=./secrets/qizzone-migrator-connection-string.txt
FIREBASE_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json

# Use a separate staging hostname and test Firebase project. Do not change production DNS here.
API_HOST=api.staging.example.com
ACME_EMAIL=ops@example.com
FRONTEND_ORIGIN=https://staging.example.com
FIREBASE_PROJECT_ID=
BOOTSTRAP_ADMIN_UID=

# Optional resource ceilings for one small VM.
API_CPU_LIMIT=1
API_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=0.5
POSTGRES_MEMORY_LIMIT=4g
WORKER_CPU_LIMIT=0.25
WORKER_MEMORY_LIMIT=1g
CADDY_CPU_LIMIT=0.25
CADDY_MEMORY_LIMIT=256m
GEMINI_API_KEY_FILE=./secrets/gemini-api-key.txt
GEMINI_MODEL=gemini-3.8-flash
QIZZONE_MIGRATION_SOURCE_CONNECTION_STRING_FILE=./secrets/source-connection-string.txt
